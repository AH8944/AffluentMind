{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Deploy config for the affluentmind worker (your own Cloudflare account).
  // Generated from the same build output the platform CI uses: vite emits
  // dist/server/server.js, a Worker default-export `fetch`.
  "name": "affluentmind",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": {
    "HF_ENV": "production",
    "APP_SLUG": "affluentmind"
  }
}
